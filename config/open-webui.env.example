# Настройки Open WebUI. На сервере: /opt/school-ai/config/open-webui.env (права 600).
# Создаётся deploy/install.sh. Полный список: https://docs.openwebui.com/reference/env-configuration
#
# ВАЖНО: часть настроек (ENABLE_SIGNUP, DEFAULT_USER_ROLE, DEFAULT_MODELS, ...)
# читается только при ПЕРВОМ запуске, дальше они хранятся в базе Open WebUI
# и меняются в интерфейсе: Панель администратора → Настройки.

# Где слушать. 127.0.0.1 — только с сервера / через SSH-туннель.
# 0.0.0.0 — для всех в локальной сети (после регистрации администратора!).
HOST=127.0.0.1
PORT=8080

# Адреса, с которых открывают интерфейс (через «;»). Добавьте сюда адрес
# сервера в сети школы, когда откроете доступ.
CORS_ALLOW_ORIGIN=http://localhost:8080;http://127.0.0.1:8080;http://192.168.2.101:8080

DATA_DIR=/opt/school-ai/open-webui/data
HF_HOME=/opt/school-ai/open-webui/data/cache/huggingface
WEBUI_NAME="School AI"
WEBUI_SECRET_KEY=__WEBUI_SECRET_KEY__

# Регистрация: первый зарегистрированный — администратор,
# остальные ждут одобрения администратора (pending).
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=pending

# Модели: Ollama напрямую (свободный чат с Qwen) + наш RAG как «OpenAI»
OLLAMA_BASE_URL=http://127.0.0.1:11434
ENABLE_OPENAI_API=true
OPENAI_API_BASE_URLS=http://127.0.0.1:8000/v1
OPENAI_API_KEYS=__API_KEY__
DEFAULT_MODELS=school-docs
# Модель для служебных задач (названия чатов, теги)
TASK_MODEL=qwen3:14b
# Передавать в наш API имя/email пользователя (для журнала вопросов)
ENABLE_FORWARD_USER_INFO_HEADERS=true

# Встроенный RAG Open WebUI (для файлов, прикреплённых прямо в чат) — тоже локально
RAG_EMBEDDING_ENGINE=ollama
RAG_EMBEDDING_MODEL=qwen3-embedding:4b

# Никаких внешних сервисов
ENABLE_WEB_SEARCH=false
ENABLE_COMMUNITY_SHARING=false
ENABLE_EVALUATION_ARENA_MODELS=false
ANONYMIZED_TELEMETRY=false
DO_NOT_TRACK=true
SCARF_NO_ANALYTICS=true
