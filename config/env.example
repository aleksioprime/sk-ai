# Настройки School AI.
# На сервере файл лежит в /opt/school-ai/config/.env (права 600, владелец service).
# deploy/install.sh создаёт его автоматически со случайным паролем БД.
# НЕ храните настоящий .env в git и не пересылайте его в чаты.

# --- PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=school_ai
DB_USER=school_ai
DB_PASSWORD=__DB_PASSWORD__

# --- Ollama ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=qwen3-embedding:4b
# Размерность векторов. Если поменять — нужна полная переиндексация
# и пересоздание колонки embedding (см. docs/03-maintenance.md).
EMBED_DIMENSIONS=1024
# Сколько токенов контекста давать модели
OLLAMA_NUM_CTX=16384

# --- Файлы ---
DATA_DIR=/opt/school-ai/data

# --- Веб-интерфейс ---
# 127.0.0.1 — доступен только с самого сервера (и через SSH-туннель).
# 0.0.0.0   — доступен всем в локальной сети: тогда ОБЯЗАТЕЛЬНО задайте WEB_PASSWORD.
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_USER=school
WEB_PASSWORD=

# --- API для Open WebUI ---
# Ключ доступа к /v1 (создаётся install.sh). Тот же ключ записан в open-webui.env.
API_KEY=__API_KEY__
